---
/**
 * One entry in a post listing.
 *
 * Receives a `PostSummary`, never a loader entry, and never the body: the listing
 * is a list of summaries and the theme cannot ask for more. Dates are formatted in
 * UTC so a post's date never shifts with the reader's time zone.
 *
 * `level` exists for one reason: heading hierarchy. On the home page the `<h1>` is
 * the site name in the hero, so the cards under it are `<h3>`; on a tag listing the
 * `<h1>` is the listing heading, so the same card is an `<h2>`. Getting this wrong
 * is invisible in a screenshot and obvious to a screen reader.
 *
 * The card is two rails — an article rail (title, excerpt, byline) and a preview
 * image — and the listing lays consecutive cards in a zig-zag. The alternation is
 * pure CSS (see `.post-list > li:nth-child(even)` in public.css); this component
 * renders one card and does not know which side of the page it will land on.
 */
import type { PostSummary } from '../../../../theme-system/contract';

interface Props {
  post: PostSummary;
  /** Heading level for the post title. 2 on a listing page, 3 under the hero. */
  level?: 2 | 3;
}

const { post, level = 2 } = Astro.props;

const Heading = level === 3 ? 'h3' : 'h2';

// The full date: weekday, month, day and year, in UTC so a post's date never
// shifts with the reader's time zone.
const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'full', timeZone: 'UTC' });
---

<article class="post-card">
  {
    /*
     * The article rail. It carries everything that is *about* the post — the
     * title, the excerpt and the byline — and it is the wider of the two rails,
     * so a row reads as a lead article with a supporting image rather than as two
     * symmetric halves.
     */
  }
  <div class="post-card-content">
    <Heading><a href={post.href}>{post.title}</a></Heading>

    {post.description && <p class="post-description">{post.description}</p>}

    <p class="post-meta">
      {
        /*
         * The author avatar is a reserved slot. The content model carries no
         * author yet, so this is the shape a name and a picture will occupy once
         * frontmatter grows one — a byline that already exists, rather than a hole
         * that has to be reopened later. It is aria-hidden because an empty
         * avatar says nothing a screen reader should read out.
         */
      }
      <span class="post-author" aria-hidden="true">
        <span class="post-author-avatar">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            focusable="false"
          >
            <circle cx="12" cy="8.5" r="3.8"></circle>
            <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
          </svg>
        </span>
      </span>

      <time datetime={post.date.toISOString()}>{fmt.format(post.date)}</time>
      {post.updated && <span>更新于 {fmt.format(post.updated)}</span>}
      {post.draft && <span class="status status-draft">草稿</span>}
      {
        post.tags.length > 0 && (
          <ul class="tag-list">
            {post.tags.map((tag) => (
              <li>
                <a class="tag" href={tag.href} aria-current={tag.current ? 'page' : undefined}>
                  {tag.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </p>
  </div>

  {
    /*
    ARCHITECTURE.md §80/§132/§133: a cover in a listing is below the fold, so it is
    lazy, and it carries the recorded width and height so the card does not change
    size when the bytes arrive. The URL is the original; the delivery layer decides
    the format per visitor (§81).

    A post with no cover still gets the strip — the same reserved box, dashed, as
    the single post page reserves its frame. Two reasons, and the second is the one
    that matters: a listing card is a *layout* decision, so the author can see where
    the image will sit and how tall the row will be, and adding `cover:` to the
    frontmatter then fills the strip without moving the title, the description or
    anything beside it. A card that grows the moment a cover is added is a card
    whose neighbours jump.

    It stays a link with the same href, aria-hidden and tabindex as the real cover,
    so the card's hover area and its accessibility are identical either way — there
    is no version of this card where the frame is focusable and the image is not.
    */
  }
  {
    post.cover ? (
      <a class="post-card-cover" href={post.href} tabindex="-1" aria-hidden="true">
        <img
          src={post.cover.url}
          alt=""
          loading={post.cover.lazy ? 'lazy' : 'eager'}
          decoding="async"
        />
      </a>
    ) : (
      <a
        class="post-card-cover post-card-cover-empty"
        href={post.href}
        tabindex="-1"
        aria-hidden="true"
      >
        <svg
          class="post-card-cover-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          <rect x="3" y="5" width="18" height="14" rx="3.5" />
          <circle cx="9" cy="10.4" r="1.7" />
          <path d="M3.6 17.2 9 12.6l3.9 3.4 3.2-2.7 4.3 3.9" />
        </svg>
        <span class="post-card-cover-label">封面图预留位</span>
      </a>
    )
  }
</article>
