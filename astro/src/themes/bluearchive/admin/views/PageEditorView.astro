---
/**
 * The page editor. Structurally the post editor, for content/pages/.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminNotice from '../components/AdminNotice.astro';
import AdminMediaPicker from '../components/AdminMediaPicker.astro';

import type {
  AdminShellView,
  PageEditorView,
  Notice,
  SeoView,
} from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  shell: AdminShellView;
  /**
   * Head metadata for this screen.
   *
   * ARCHITECTURE.md §77: computed by the core and rendered here. No admin view
   * names a favicon or composes a document title.
   */
  seo: SeoView;
  view: PageEditorView;
  notice?: Notice | null;
  csrfToken: string;
  signedIn: boolean;
}

const { theme, shell, seo, view, notice = null, csrfToken, signedIn } = Astro.props;
---

<AdminLayout theme={theme} shell={shell} seo={seo} csrfToken={csrfToken} signedIn={signedIn}>
  <h1>{view.isNew ? '新建页面' : '编辑页面'}</h1>

  <AdminNotice notice={notice} />

  {
    !view.isNew && view.path && (
      <p class="muted">
        文件路径 <code>{view.path}</code>
      </p>
    )
  }

  <div class="admin-panel">
    <form
      id="page-form"
      class="form-grid"
      novalidate
      data-cms-form="page"
      data-cms-mode={view.isNew ? 'create' : 'update'}
      data-cms-slug={view.slug}
      data-cms-csrf={csrfToken}
    >
      <div class="field">
        <label for="title">标题</label>
        <input id="title" name="title" type="text" value={view.title} required maxlength="200" />
        <p class="field-error" data-cms-error-for="title" hidden></p>
      </div>

      <div class="field">
        <label for="slug">Slug(短名)</label>
        {
          view.isNew ? (
            <input
              id="slug"
              name="slug"
              type="text"
              value={view.slug}
              required
              maxlength="80"
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              aria-describedby="page-slug-hint"
            />
          ) : (
            <>
              <input id="slug" type="text" value={view.slug} disabled />
              <input type="hidden" name="slug" value={view.slug} />
            </>
          )
        }
        <p class="hint" id="page-slug-hint">
          该页面会通过 <code>/&lt;slug&gt;</code> 访问。以下名称被保留:admin、posts、tags、login、 logout。
        </p>
        <p class="field-error" data-cms-error-for="slug" hidden></p>
      </div>

      <div class="field">
        <label for="navOrder">导航排序</label>
        <input
          id="navOrder"
          name="navOrder"
          type="number"
          value={view.navOrder}
          min="0"
          max="9999"
        />
        <p class="hint">数字越小越靠前显示。可留空。</p>
        <p class="field-error" data-cms-error-for="navOrder" hidden></p>
      </div>

      <div class="field">
        <label for="description">描述</label>
        <input
          id="description"
          name="description"
          type="text"
          value={view.description}
          maxlength="300"
        />
        <p class="field-error" data-cms-error-for="description" hidden></p>
      </div>

      <div class="field">
        <label for="cover">封面图</label>
        <input id="cover" name="cover" type="text" value={view.cover} maxlength="300" />
        <p class="hint">
          可由下方选择器填入,也可手动粘贴。按输入原样保存:具体格式由传输层按访客逐次决定, 因此 URL
          永不改变。
        </p>
        <p class="field-error" data-cms-error-for="cover" hidden></p>
        <AdminMediaPicker
          target="cover"
          value="url"
          label={view.cover ? '更换封面' : '选择封面'}
          items={view.media}
          maxBytes={view.mediaMaxBytes}
          current={view.cover}
          csrfToken={csrfToken}
        />
      </div>

      <div class="field">
        <label class="field-inline">
          <input id="draft" name="draft" type="checkbox" checked={view.draft} />
          <span>草稿 —— 访客不可见</span>
        </label>
      </div>

      <div class="field">
        <label for="body">正文 (Markdown)</label>
        <textarea id="body" name="body" required>{view.body}</textarea>
        <p class="field-error" data-cms-error-for="body" hidden></p>
      </div>

      <div class="field">
        <p class="hint">向正文插入图片</p>
        <div
          class="field-inline"
          data-cms-form="upload"
          data-cms-insert-markdown="body"
          data-cms-csrf={csrfToken}
          data-cms-upload-started-at={Date.now()}
        >
          <label class="visually-hidden" for="body-image">选择图片</label>
          <input
            id="body-image"
            name="file"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/gif"
          />
          <button class="btn" type="button" data-cms-upload-submit>上传并插入</button>
          <span class="spinner" data-cms-spinner hidden>上传中…</span>
          <p class="field-error" data-cms-error-for="file" hidden></p>
        </div>
        <p class="hint">
          先上传到媒体库,然后在光标处写入 <code>![name](/media/…)</code>。文件本身绝不会 内联进
          Markdown。
        </p>
      </div>

      <div class="field-inline">
        <button class="btn btn-primary" type="submit">
          {view.isNew ? '创建页面' : '保存修改'}
        </button>
        <span class="spinner" data-cms-spinner hidden>保存中…</span>
        <a class="btn" href="/admin/pages">取消</a>
      </div>
    </form>
  </div>

  {
    !view.isNew && (
      <section class="danger-zone">
        <h2>危险操作</h2>
        <p class="muted">
          删除会从磁盘移除 <code>{view.path}</code>。
        </p>
        <button
          class="btn btn-danger"
          type="button"
          data-cms-action="delete-content"
          data-cms-kind="page"
          data-cms-slug={view.slug}
          data-cms-csrf={csrfToken}
          data-cms-confirm={`确定删除 "${view.slug}"?该 Markdown 文件会从磁盘移除。`}
        >
          删除这个页面
        </button>
      </section>
    )
  }
</AdminLayout>
