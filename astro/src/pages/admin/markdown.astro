---
/**
 * Markdown style templates.
 *
 * ARCHITECTURE.md §34: `content/system/markdown/NNN-name.css`
 * files are the presentation layer for rendered Markdown content.
 * They live in the content tree, Go is the only writer, and the
 * browser only ever sees `/markdown.css` — which the CMS assembles
 * per request. This screen lists them, creates them, edits them,
 * renames them, switches them on and off and deletes them, and
 * provides a sandbox editor whose preview runs the same
 * `renderMarkdown()` a post page runs.
 *
 * The sandbox's starting document is owned here: it is core
 * reference material for testing a template, not theme content,
 * so it travels through the view model rather than living in a
 * theme.
 *
 * Every server-side call forwards the session cookie explicitly —
 * there is no cookie jar during SSR, and skipping it renders this
 * screen 200 with an empty list (ARCHITECTURE.md ID-20).
 */
import { adminFetch } from '../../lib/admin-api';
import { adminSeo, csrfToken, shell, signedIn } from '../../lib/admin-context';
import type {
  MarkdownTemplatesView as MarkdownTemplatesData,
  MarkdownTemplateItem,
} from '../../theme-system/contract';

type TemplateList = { templates: MarkdownTemplateItem[]; maxBytes: number };
type Notice = { kind: 'error' | 'warn'; message: string };

/**
 * A self-contained placeholder image.
 *
 * The sandbox renders the sample through the same pipeline a
 * post page runs, and the Content-Security-Policy allows
 * `img-src 'self' data: https://gitee.com` — so the sample
 * uses a `data:` SVG rather than an external placeholder
 * service the CSP would block. `encodeURIComponent` keeps
 * the SVG a single URL token: no raw spaces, angle brackets
 * or quotes for the Markdown link parser to trip on.
 *
 * The SVG's colours are named colours, not hex literals:
 * this is article *content* (a placeholder graphic, like any
 * image a post would carry), not component chrome, so there
 * is no theme token for it to go through — but a literal in
 * an .astro file is what the architecture gate refuses, and
 * a named colour says the same thing without one.
 *
 * The SVG is assembled from an array, not written as a
 * template literal nested inside the data URI's
 * interpolation. Prettier's Astro parser cannot parse a
 * template literal whose interpolation spans several lines
 * and contains another template literal — `make lint`
 * reports the frontmatter as an unterminated template.
 * Keeping the pieces flat is what keeps the file lintable.
 */
const sampleImage = (width: number, height: number, label: string) => {
  const svg = [
    `<svg xmlns='http://www.w3.org/2000/svg' width='${width}' height='${height}'>`,
    `<rect width='100%' height='100%' fill='lightgray'/>`,
    `<text x='50%' y='50%' text-anchor='middle' fill='gray' font-size='20'>${label}</text>`,
    '</svg>',
  ].join('');
  return `data:image/svg+xml;utf8,${encodeURIComponent(svg)}`;
};

/**
 * The sandbox's starting document.
 *
 * It exercises every component the template system knows —
 * headings, emphasis, lists, links, images, callouts, a card,
 * a figure with a caption, kbd and badge directives, tables,
 * blockquotes, task lists, a code fence and a horizontal rule —
 * so an admin who has never written a template can see what
 * each one does.
 *
 * The directive grammar is micromark's: `:kbd[Ctrl]` is a
 * text directive (one colon, label in brackets, no colon
 * before the bracket). `:kbd:[Ctrl]` is not a directive and
 * renders as literal text, so the sample uses the form that
 * actually renders.
 */
const SAMPLE_MARKDOWN = `# A template for every component

Text can be **bold**, *italic* or ~~struck through~~, and a
[link](https://example.com) goes somewhere. An image is
![a placeholder](${sampleImage(640, 160, 'placeholder')}).

:::info
An **info** callout: context the reader should know.
:::

:::warning
A **warning** callout: something easy to get wrong.
:::

:::danger
A **danger** callout: destructive or irreversible.
:::

:::card
A card is a neutral container for anything — a link list, a
quote, a download.
:::

Press :kbd[Ctrl] + :kbd[S] to save. Drafts carry a :badge[未发布] badge.

:::figure
![a wide placeholder](${sampleImage(800, 300, 'wide placeholder')})

The figure caption: a plain paragraph below a blank line.
:::

| Syntax | Renders |
| --- | ---- |
| \`:::info\` | an info callout |
| \`:kbd[Ctrl]\` | a keyboard key |

> A blockquote is a quote.

- [ ] a task
- [x] another task

\`\`\`go
// A fenced code block, styled by the code-block template.
func main() {}
\`\`\`

---
`;

let view: MarkdownTemplatesData = {
  templates: [],
  maxBytes: 0,
  editor: null,
  editorContent: '',
  sample: SAMPLE_MARKDOWN,
};
let notice: Notice | null = null;

// The template the editor is showing, if any. The filename
// alone identifies the file: it is both the identity and the
// storage key, so no second parameter has to be kept in step
// with it.
const wanted = Astro.url.searchParams.get('name') ?? '';

try {
  const list = await adminFetch<TemplateList>('/api/v1/admin/markdown', {
    cookie: Astro.locals.cookie,
  });
  view = {
    templates: list.templates,
    maxBytes: list.maxBytes,
    editor: null,
    editorContent: '',
    sample: SAMPLE_MARKDOWN,
  };

  if (wanted !== '') {
    const found = view.templates.find((template) => template.filename === wanted);
    if (found === undefined) {
      notice = { kind: 'warn', message: `No style template named ${wanted}.` };
    } else if (found.status !== 'ok') {
      // Editing a template the aggregator refuses to serve would
      // produce a file that saves and then does nothing, so the
      // screen says why instead.
      notice = {
        kind: 'warn',
        message: `${found.filename} is not served: ${found.problem}.`,
      };
    } else {
      view.editor = found;
      const detail = await adminFetch<{ content: string }>(
        `/api/v1/admin/markdown/${encodeURIComponent(wanted)}`,
        { cookie: Astro.locals.cookie },
      );
      view.editorContent = detail.content;
    }
  }
} catch (err) {
  notice = {
    kind: 'error',
    message: err instanceof Error ? err.message : 'Could not load the style templates.',
  };
}

const theme = Astro.locals.theme;
const MarkdownView = theme.admin.MarkdownView;

const shellView = await shell(Astro.locals, 'Markdown', 'markdown');
const seoView = await adminSeo('Markdown', Astro.url, Astro.locals.theme);
---

<MarkdownView
  theme={theme}
  shell={shellView}
  seo={seoView}
  view={view}
  notice={notice}
  csrfToken={csrfToken(Astro.locals)}
  signedIn={signedIn(Astro.locals)}
/>
