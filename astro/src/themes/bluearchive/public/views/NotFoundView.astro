---
/**
 * The 404 screen.
 *
 * A theme owns this too: a replacement theme that left it out would leave the
 * origin's error page in whatever the previous theme looked like.
 */
import Layout from '../layouts/PublicLayout.astro';

import type { SiteView } from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  site: SiteView;
}

const { theme, site } = Astro.props;
---

<Layout theme={theme} site={site}>
  <div class="error-page">
    <h1>404 — 页面不存在</h1>
    <p>该页面不存在,可能已被重命名或删除。</p>
    <p><a href="/">返回文章列表</a></p>
  </div>
</Layout>
