# Blog CMS — environment template.
#
# Copy to `.env`, fill in, and never commit the result. `.env` is in
# .gitignore. Nothing here is a real credential: every secret below is a
# *name*, and every value shown is a placeholder.
#
# The backend reads this through `config.Load` and refuses to start on a
# configuration error (ARCHITECTURE.md §6): a misconfigured deployment fails
# loudly rather than silently serving an empty site.
#
# The process reads its environment, so load this file into it the way your
# deployment does (`docker compose --env-file`, `set -a; . ./.env; set +a`,
# a systemd EnvironmentFile, …). There is no in-process .env loader on purpose:
# one more mechanism to read configuration would be one more place for it to
# disagree with the deployment.

# ---------------------------------------------------------------------------
# Roots. All three are required and must already exist.
# ---------------------------------------------------------------------------
CONTENT_ROOT=/srv/blog/content
MEDIA_ROOT=/srv/blog/media
DATA_ROOT=/srv/blog/data

# Optional: where the derived WebP representations live. Default
# <DATA_ROOT>/media-cache. It is derived state and may be wiped at any time.
# MEDIA_CACHE_ROOT=/srv/blog/media-cache

# ---------------------------------------------------------------------------
# The listen address. The Go backend binds to loopback only: Astro is the
# single origin and proxies /api/* to it (ARCHITECTURE.md ID-11).
# ---------------------------------------------------------------------------
BIND=127.0.0.1
PORT=8080

# ---------------------------------------------------------------------------
# Browser-facing address. Same-origin mutations need no entry here; this adds
# what the same-origin comparison cannot see — a hostname, or a site behind
# TLS termination (ARCHITECTURE.md ID-24). Comma-separated for several.
#
# With this unset AND no entry in Settings, the Origin check accepts exactly the
# address the browser dialled: a site works on any public IP, port-forward or
# new domain with no configuration at all. The same list can also be edited from
# the admin screen (Settings → 访问地址), taking effect without a restart.
# ---------------------------------------------------------------------------
# PUBLIC_ORIGIN=https://blog.example.com

# Set only when the site is reached over HTTPS. Off by default so an install
# reached over plain HTTP can still sign in.
# SECURE_COOKIES=false

# ---------------------------------------------------------------------------
# Deployment mode.
#
# The first administrator of a *production* deployment is generated by the
# backend: a random username (owner-xxxxxx) and a 20-character password,
# shown exactly once by the first-run screen. There is no default username
# and no default password anywhere in this repository.
#
# APP_ENV=development (or dev) additionally lets the first-run form create
# the account from credentials you type — which is the convenience a local
# checkout wants, and the reason nobody should set it on a reachable host.
# An unset or unrecognised value is production.
# ---------------------------------------------------------------------------
# APP_ENV=production

# ---------------------------------------------------------------------------
# Sessions.
# ---------------------------------------------------------------------------
SESSION_TTL=12h
SESSION_IDLE_TTL=2h
# SESSION_SECRET_FILE=/srv/blog/secrets/session.key

# ---------------------------------------------------------------------------
# Limits.
# ---------------------------------------------------------------------------
MAX_JSON_BODY=1048576
MAX_UPLOAD_BYTES=5242880
IMAGE_MAX_PIXELS=20000000
IMAGE_MEMORY_CACHE_MB=64
LOGIN_PER_MINUTE=5
LOGIN_PER_HOUR=20
COMMENT_PER_HOUR=5

# ---------------------------------------------------------------------------
# Local Git backup (Git Backup Phase 1). A local commit is the whole feature:
# there is no remote, and none of these values is required for it to work.
# ---------------------------------------------------------------------------
# GIT_BACKUP_ROOT=/srv/blog/data/git-backup
# GIT_DEFAULT_BRANCH=main
# GIT_BACKUP_MAX_FILE_BYTES=134217728
# GIT_BACKUP_MAX_TOTAL_BYTES=2147483648
# GIT_BACKUP_TIMEOUT=60s

# ---------------------------------------------------------------------------
# GitHub account binding (optional).
#
# Binds a GitHub identity to a CMS administrator. Binding is identity
# association only: it requests no scopes (the public profile is all it
# reads), grants no repository access and adds no remote-backup capability.
# Leave all of these unset and nothing changes: password sign-in, sessions,
# CSRF, rate limits and local backup do not touch GitHub. Setting only some of
# them is a startup error, not a partially working feature.
#
# Create a GitHub OAuth App (no permissions are needed for binding) with this
# callback URL, and use its *user authorization* flow:
#   https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/authorizing-oauth-apps
#
# The credential encryption key is NOT here. The backend owns it: a
# fixed-name file, github-credential.key, inside DATA_ROOT, created once
# with crypto/rand on the first binding (0600). It is never regenerated,
# so losing DATA_ROOT means unbinding and re-binding, not a reset.
#
# OAuth application credentials are deployment configuration by design:
# they identify the application, not an administrator. No admin screen
# holds a client secret, and none needs a key path.
#
# GITHUB_CLIENT_ID=Iv1.0123456789abcdef
# GITHUB_CLIENT_SECRET= Paste the OAuth App's client secret here — never the client ID.
#
# The fixed callback address, exactly as registered with GitHub. Must be
# https in production, must have no query or fragment, and must point at the
# single origin (Astro proxies /api/* to the Go backend):
#   GITHUB_CALLBACK_URL=https://blog.example.com/api/v1/admin/github/callback
#
# How long one start→callback transaction stays valid. 1m…1h.
GITHUB_OAUTH_STATE_TTL=10m
#
# Endpoint overrides. A real deployment never sets these: with them unset the
# authorization goes to https://github.com/login/oauth/authorize and the token
# and user calls go to https://api.github.com, whatever else this file says.
#
# They exist for two explicit cases — a GitHub Enterprise Server host, and a
# test harness driving the flow against a local stand-in — and because they are
# the two ways to make the admin's "bind" button leave for somewhere other than
# github.com, they are honoured only when the opt-in below is set. A deployment
# whose environment still carries a test harness's
# GITHUB_WEB_BASE=http://127.0.0.1:9911 without it REFUSES TO START, naming
# both variables: the override is otherwise trusted silently, and "the bind
# button went to the wrong GitHub" is invisible until someone reads the address
# bar.
#   GITHUB_ALLOW_ENDPOINT_OVERRIDES=true
#   GITHUB_WEB_BASE=https://github.example.com
#   GITHUB_API_BASE=https://github.example.com/api/v3
