---
/**
 * The post editor: create or update.
 *
 * ARCHITECTURE.md §43: a plain textarea plus separate frontmatter fields, so the
 * file on disk stays plain Markdown and Go round-trips raw frontmatter and body
 * rather than rendered HTML (ARCHITECTURE.md §1).
 *
 * ARCHITECTURE.md §10/§45: this view has no idea what a CSRF token is. It places
 * the one the core handed it in a data attribute, and /cms.js sends it. The
 * theme cannot obtain, forge or omit the requirement — omitting the attribute
 * only makes every save fail.
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminNotice from '../components/AdminNotice.astro';
import AdminMediaPicker from '../components/AdminMediaPicker.astro';

import type {
  AdminShellView,
  PostEditorView,
  Notice,
  SeoView,
} from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  shell: AdminShellView;
  /**
   * Head metadata for this screen.
   *
   * ARCHITECTURE.md §77: computed by the core and rendered here. No admin view
   * names a favicon or composes a document title.
   */
  seo: SeoView;
  view: PostEditorView;
  notice?: Notice | null;
  /** Per-session CSRF token from the core. */
  csrfToken: string;
  signedIn: boolean;
}

const { theme, shell, seo, view, notice = null, csrfToken, signedIn } = Astro.props;
---

<AdminLayout theme={theme} shell={shell} seo={seo} csrfToken={csrfToken} signedIn={signedIn}>
  <h1>{view.isNew ? '写文章' : '编辑文章'}</h1>

  <AdminNotice notice={notice} />

  {
    !view.isNew && view.path && (
      <p class="muted">
        文件路径 <code>{view.path}</code>
      </p>
    )
  }

  <div class="admin-panel">
    <form
      id="post-form"
      class="form-grid"
      novalidate
      data-cms-form="post"
      data-cms-mode={view.isNew ? 'create' : 'update'}
      data-cms-slug={view.slug}
      data-cms-csrf={csrfToken}
    >
      <div class="field">
        <label for="title">标题</label>
        <input
          id="title"
          name="title"
          type="text"
          value={view.title}
          required
          maxlength="200"
          autocomplete="off"
        />
        <p class="field-error" data-cms-error-for="title" hidden></p>
      </div>

      <div class="field">
        <label for="slug">Slug(短名)</label>
        {
          view.isNew ? (
            <input
              id="slug"
              name="slug"
              type="text"
              value={view.slug}
              required
              maxlength="80"
              pattern="[a-z0-9]+(-[a-z0-9]+)*"
              autocomplete="off"
              aria-describedby="slug-hint"
            />
          ) : (
            <>
              <input id="slug" type="text" value={view.slug} disabled />
              <input type="hidden" name="slug" value={view.slug} />
            </>
          )
        }
        <p class="hint" id="slug-hint">
          {
            view.isNew
              ? '仅允许小写字母、数字和单个连字符。它同时是文件名和 URL。'
              : 'slug 就是文件名。要移动这篇文章,请新建一篇再删除这一篇。'
          }
        </p>
        <p class="field-error" data-cms-error-for="slug" hidden></p>
      </div>

      <div class="field">
        <label for="date">日期</label>
        <input id="date" name="date" type="date" value={view.date} required />
        <p class="field-error" data-cms-error-for="date" hidden></p>
      </div>

      <div class="field">
        <label for="description">描述</label>
        <input
          id="description"
          name="description"
          type="text"
          value={view.description}
          maxlength="300"
        />
        <p class="hint">用作 meta description 和 RSS 订阅源摘要。可留空。</p>
        <p class="field-error" data-cms-error-for="description" hidden></p>
      </div>

      <div class="field">
        <label for="tags">标签</label>
        <input
          id="tags"
          name="tags"
          type="text"
          value={view.tags}
          maxlength="700"
          placeholder="astro, fileless"
        />
        <p class="hint">用逗号分隔,最多 20 个。仅允许小写字母、数字和连字符。</p>
        <p class="field-error" data-cms-error-for="tags" hidden></p>
      </div>

      <div class="field">
        <label for="cover">封面图</label>
        <input id="cover" name="cover" type="text" value={view.cover} maxlength="300" />
        <p class="hint">
          可由下方选择器填入,也可手动粘贴。按输入原样保存:具体格式由传输层按访客逐次决定, 因此 URL
          永不改变。
        </p>
        <p class="field-error" data-cms-error-for="cover" hidden></p>
        <AdminMediaPicker
          target="cover"
          value="url"
          label={view.cover ? '更换封面' : '选择封面'}
          items={view.media}
          maxBytes={view.mediaMaxBytes}
          current={view.cover}
          csrfToken={csrfToken}
        />
      </div>

      <div class="field">
        <label class="field-inline">
          <input id="draft" name="draft" type="checkbox" checked={view.draft} />
          <span>草稿 —— 访客不可见</span>
        </label>
      </div>

      <div class="field">
        <label>正文 (Markdown)</label>
        {
          /*
            §33: the body is written in the standalone Markdown editor. The form
            still carries it — the post PUT replaces the whole document — but in a
            hidden textarea, so a metadata-only save never wipes it. A textarea
            rather than a hidden input, because only a textarea round-trips the
            newlines exactly.
          */
        }
        <textarea name="body" hidden>{view.body}</textarea>
        {
          view.isNew ? (
            <p class="hint">保存后即可在 Markdown 编辑器中编写正文。</p>
          ) : (
            <div class="field-inline">
              <a
                class="btn"
                href={`/admin/posts/markdown/editor?kind=post&slug=${encodeURIComponent(view.slug)}`}
              >
                编辑正文
              </a>
              <span class="hint">正文、插图都在 Markdown 编辑器里完成。</span>
            </div>
          )
        }
        <p class="field-error" data-cms-error-for="body" hidden></p>
      </div>

      <div class="field-inline">
        <button class="btn btn-primary" type="submit">
          {view.isNew ? '创建文章' : '保存修改'}
        </button>
        <span class="spinner" data-cms-spinner hidden>保存中…</span>
        <a class="btn" href="/admin/posts">取消</a>
      </div>
    </form>
  </div>

  {
    !view.isNew && (
      <section class="danger-zone">
        <h2>危险操作</h2>
        <p class="muted">
          删除会从磁盘移除 <code>{view.path}</code>。此操作无法在此撤销。
        </p>
        <button
          class="btn btn-danger"
          type="button"
          data-cms-action="delete-content"
          data-cms-kind="post"
          data-cms-slug={view.slug}
          data-cms-csrf={csrfToken}
          data-cms-confirm={`确定删除 "${view.slug}"?该 Markdown 文件会从磁盘移除。`}
        >
          删除这篇文章
        </button>
      </section>
    )
  }
</AdminLayout>
