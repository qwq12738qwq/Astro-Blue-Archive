---
/**
 * A standalone page served at `/<slug>`.
 */
import Layout from '../layouts/PublicLayout.astro';

import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { SiteView, PageView } from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  site: SiteView;
  page: PageView;
}

const { theme, site, page } = Astro.props;

const Body = page.content as AstroComponentFactory;
---

<Layout theme={theme} site={site}>
  <header class="page-header">
    <h1>{page.title}</h1>
    {page.draft && <span class="status status-draft">草稿</span>}
  </header>

  <article class="page-card">
    <div class="prose">
      <Body />
    </div>
  </article>
</Layout>
