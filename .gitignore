# Dependencies
node_modules/
astro/dist/
astro/.astro/
backend/server
backend/healthcheck

# Runtime data (content/, media/ and data/ ARE persisted via Docker volumes,
# but must not be committed as build artefacts)
data/*.db
data/*.db-shm
data/*.db-wal
data/session_secret
media/*
!media/.gitkeep
!data/.gitkeep

# The site's own articles and pages are the deployer's content, not
# part of the project: they stay on disk (and in the deployment's
# volumes) and never land in git.
content/posts/
content/pages/

# Local env
.env
.env.local

# Astro tooling cache (generated by `astro check`)
.astro/

# Editor / OS
.DS_Store
*.swp

# Local build artefacts
backend/bin/

# Backup archives are produced by scripts/backup.sh
data/backups/
# Derived image cache; keyed by checksum, regenerated on demand
data/media-cache/
.playwright-mcp/
.local-run/
/WordPress

# Agent-tooling state and working notes, not project source
.commandcode/
.opencode/
WORDPRESS_ANALYSIS.md
