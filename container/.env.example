# Deployment configuration. Copy to deploy/.env and edit; Compose loads it automatically.

# Browser-facing origin (the Origin check compares the visitor's origin against it).
PUBLIC_ORIGIN=http://localhost:4321

# Cookie Secure flag: true once HTTPS is in front, false for plain HTTP.
SECURE_COOKIES=false

# Host port mapping.
PUBLISH_ADDRESS=0.0.0.0
PUBLISH_PORT=4321

# Site port inside the container.
WEB_PORT=4321

# Optional: local Git backup root.
# GIT_BACKUP_ROOT=/app/data/git-backup

# Optional: GitHub account binding (set all three or none).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=https://example.com/api/v1/admin/github/callback