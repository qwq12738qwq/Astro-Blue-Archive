---
/**
 * The home page: a artwork banner closed by a wave seam, the site's
 * name, a derived stats strip, recent posts in a grid, and the tags.
 *
 * The hero this theme grew up with — the big card with the eyebrow,
 * the typewriter line and the call-to-action button — is gone. The
 * banner is a decorative band the wave seam sinks into the page, and
 * the site's name sits below it, not on it.
 *
 * ARCHITECTURE.md §37: what the header *says* is CMS settings, not
 * theme copy. The title, the subtitle and the description are the
 * same values the head uses for the meta description and the feed, so
 * the page a visitor reads and the metadata a crawler reads cannot
 * disagree.
 *
 * The stats strip is *derived*: every number is computed here from the
 * listing the core already passes, so it asks nothing of the API and
 * cannot disagree with the list below it. An empty blog withholds the
 * strip rather than showing zeroes.
 */
import Layout from '../layouts/PublicLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagCloud from '../components/TagCloud.astro';
import WaveSeam from '../components/WaveSeam.astro';

import type { SiteView, ListingView } from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  site: SiteView;
  listing: ListingView;
}

const { theme, site, listing } = Astro.props;

const posts = listing.posts;

// The lead falls back to the listing heading so the hero is never an empty band.
// `description` is already resolved with a fallback chain by lib/seo.ts, so this
// cannot render an empty element.
const lead = site.description || site.subtitle || listing.heading;

// The derived figures. The tag set is flat-mapped and de-duplicated because a
// tag shared by three posts is one tag, not three; the last update is the later
// of each post's `updated` and `date`, so a never-edited post still counts.
const tagCount = new Set(posts.flatMap((post) => post.tags.map((tag) => tag.name))).size;
const lastUpdate = posts.reduce<Date | null>((newest, post) => {
  const stamp = post.updated ?? post.date;
  return newest === null || stamp > newest ? stamp : newest;
}, null);
const fmtDay = (date: Date) => date.toISOString().slice(0, 10);
---

<Layout theme={theme} site={site}>
  {
    /*
     * The banner is pure artwork: the picture laid over a
     * token-derived wash, its right quarter masked into
     * that wash, a top veil that dissolves the band into
     * the glass header, and the wave seam that closes the
     * bottom, all as layers of one element (see
     * public.css). It is decorative — the site's name sits
     * below it, not on it — so it is aria-hidden and
     * carries no text a screen reader would read twice.
     */
  }
  <div class="home-banner" aria-hidden="true">
    <div class="home-banner-veil"></div>
    <WaveSeam />
  </div>

  <header class="home-header">
    <h1 class="home-title">{site.title}</h1>
    {
      site.subtitle && (
        <p class="home-tagline" lang="ja">
          {site.subtitle}
        </p>
      )
    }
    <p class="home-lead">{lead}</p>
  </header>

  {
    posts.length > 0 && (
      <p class="stats-strip">
        <span>
          <span class="stat-value">{posts.length}</span> 篇文章
        </span>
        <span class="stat-sep" aria-hidden="true">
          ·
        </span>
        <span>
          <span class="stat-value">{tagCount}</span> 个标签
        </span>
        {lastUpdate && (
          <>
            <span class="stat-sep" aria-hidden="true">
              ·
            </span>
            <span>
              更新于 <time datetime={lastUpdate.toISOString()}>{fmtDay(lastUpdate)}</time>
            </span>
          </>
        )}
      </p>
    )
  }

  <section class="home-section" id="latest" aria-labelledby="latest-heading">
    <h2 id="latest-heading">{listing.heading}</h2>

    {
      posts.length === 0 ? (
        <p class="empty">{listing.emptyMessage}</p>
      ) : (
        <ul class="post-grid post-grid--lead">
          {posts.map((post, index) => (
            <li>
              {/*
               * The lead cell is the first post in the *wide* two-rail shape,
               * and only while the grid has a third cell to span past: with
               * two posts the CSS span never applies, so a wide card next to a
               * lone column would be an orphan, and the card stays a grid cell.
               * The article-first DOM order and the heading level are the same
               * in either variant.
               */}
              <PostCard
                post={post}
                level={3}
                variant={index === 0 && posts.length > 2 ? 'wide' : 'grid'}
              />
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="home-section" aria-labelledby="tags-heading">
    <h2>标签</h2>
    <TagCloud posts={posts} />
  </section>
</Layout>

<script>
  /**
   * The banner typewriter.
   *
   * The flat home page keeps the hero's typewriter:
   * the one sentence the WordPress original typed
   * from its `boxmoe_banner_font` option —
   * "一切奇迹的始发点" — forward only, in the pixel
   * face. It types into the compact header now, as
   * the line above the lead, which is where it sat
   * in the hero.
   */
  (function cmsTypewriter() {
    const header = document.querySelector('.home-header');
    if (!header) return;

    const el = document.createElement('p');
    el.className = 'cms-typewriter';
    el.setAttribute('aria-hidden', 'true');

    const lead = header.querySelector('.home-lead');
    /*
     * The reference node has to be a *direct* child of the node it is
     * inserted before, or `insertBefore` throws NotFoundError. The lead
     * lives directly under `.home-header`, so the host is the header
     * itself — and `insertBefore(el, null)` is appending, which is the
     * same thing the fallback branch wanted.
     */
    const host = lead ? lead.parentNode : header;
    if (host) host.insertBefore(el, lead);

    const phrase = '一切奇迹的始发点';
    let chars = 0;

    function type() {
      if (chars >= phrase.length) return;
      el.textContent = phrase.slice(0, chars + 1);
      chars += 1;
      const current = phrase.charAt(chars - 1);
      const punctuation = ['，', '。', ',', '.', '！', '!', '？', '?', ';', '；'];
      let delay = punctuation.indexOf(current) !== -1 ? 300 : 200;
      if (Math.random() < 0.3) delay += 100;
      window.setTimeout(type, delay);
    }

    window.setTimeout(type, 400);
  })();
</script>
