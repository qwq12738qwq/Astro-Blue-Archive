---
/**
 * A standalone page served at `/<slug>`.
 *
 * A page *with* a cover opens on the same cover hero a post gets; a page
 * without one keeps the flat header and no reserved frame — a page is authored
 * by hand, one at a time, so it has no listing to stay aligned with and no
 * slot to reserve.
 */
import Layout from '../layouts/PublicLayout.astro';
import CoverHero from '../components/CoverHero.astro';

import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { PageView } from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  site: import('../../../../theme-system/contract').SiteView;
  page: PageView;
}

const { theme, site, page } = Astro.props;

const Body = page.content as AstroComponentFactory;
---

<Layout theme={theme} site={site}>
  {
    page.cover ? (
      <CoverHero cover={page.cover} title={page.title} draft={page.draft} />
    ) : (
      <header class="page-header">
        <h1>{page.title}</h1>
        {page.draft && <span class="status status-draft">草稿</span>}
      </header>
    )
  }

  <article class="page-card">
    <div class="prose">
      <Body />
    </div>
  </article>
</Layout>
