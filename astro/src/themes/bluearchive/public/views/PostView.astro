---
/**
 * A single post: header, rendered Markdown, comments.
 *
 * The body arrives as an Astro *component*, not a string. That is deliberate: a
 * string would have to be inserted with `set:html`, which ARCHITECTURE.md D4 and
 * `make arch` both forbid for anything an author controls.
 */
import Layout from '../layouts/PublicLayout.astro';
import CommentSection from '../components/CommentSection.astro';

import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { SiteView, PostView, CommentsView } from '../../../../theme-system/contract';

interface Props {
  theme: { id: string };
  site: SiteView;
  post: PostView;
  comments: CommentsView;
}

const { theme, site, post, comments } = Astro.props;

// The core passes the rendered body as a component; `content` is the view model
// field, `Body` the component reference.
const Body = post.content as AstroComponentFactory;

const fmt = new Intl.DateTimeFormat('en', { dateStyle: 'long', timeZone: 'UTC' });
---

<Layout theme={theme} site={site}>
  <header class="page-header">
    <h1>{post.title}</h1>

    <p class="post-meta">
      <time datetime={post.date.toISOString()}>{fmt.format(post.date)}</time>
      {
        post.updated && (
          <span>
            更新于 <time datetime={post.updated.toISOString()}>{fmt.format(post.updated)}</time>
          </span>
        )
      }
      {post.draft && <span class="status status-draft">草稿</span>}
      {
        post.tags.length > 0 && (
          <ul class="tag-list">
            {post.tags.map((tag) => (
              <li>
                <a class="tag" href={tag.href} aria-current={tag.current ? 'page' : undefined}>
                  {tag.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </p>
  </header>

  {
    /*
    ARCHITECTURE.md §118/§119/§132: the cover is the URL the core resolved from the
    frontmatter, and *not* lazy — a cover at the top of a post is usually the LCP
    element, and a lazy image there delays the largest paint on the page.

    The URL is the original. WebP is chosen per request from the visitor's Accept
    header, so nothing here mentions a format (§81).

    §133 asks for width/height and this page cannot honestly supply them. The
    frontmatter carries a URL, not media metadata, and looking the dimensions up
    would mean a public page render depends on the backend — which ID-14 forbids
    outright, since the site must survive the API being down. So the box is
    reserved in public.css with an aspect-ratio instead: one rule covers a 21:9
    photo and a square logo, and the page does not jump when the bytes arrive.
    Emitting `width=""` would reserve nothing while looking as though it did. The
    admin screens, which already read the media API, do emit the attributes.

    The *slot* is reserved even when the post has no cover, which is what makes it
    a slot rather than a gap: the 21:9 frame is where the image goes, and adding
    `cover:` to the frontmatter fills it without moving anything else. The
    placeholder is inert markup with no script behind it — §19 keeps behaviour in
    the core, and a reserved box needs none — and it is aria-hidden because "this
    post has no cover yet" is information about authoring, not about the article,
    so a screen reader should not read a paragraph of it out loud.

    A <figure> wraps the image because a figure *is* an image with a caption
    option; the empty slot is a plain <div>, since a figure around nothing is a
    lie about the markup. Both carry `.post-cover`, so the reservation is one
    rule rather than two that can drift apart.
    */
  }
  {
    post.cover ? (
      <figure class="post-cover">
        <img
          src={post.cover.url}
          alt={post.cover.alt}
          decoding="async"
          loading={post.cover.lazy ? 'lazy' : 'eager'}
          fetchpriority={post.cover.lazy ? 'auto' : 'high'}
        />
      </figure>
    ) : (
      <div class="post-cover post-cover-empty" aria-hidden="true">
        <svg
          class="post-cover-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          focusable="false"
        >
          <rect x="3" y="5" width="18" height="14" rx="3.5" />
          <circle cx="9" cy="10.4" r="1.7" />
          <path d="M3.6 17.2 9 12.6l3.9 3.4 3.2-2.7 4.3 3.9" />
        </svg>
        <p class="post-cover-label">封面图预留位</p>
        <p class="post-cover-hint">cover: /media/…</p>
      </div>
    )
  }

  <article class="page-card">
    <div class="prose">
      <Body />
    </div>
  </article>

  <CommentSection comments={comments} />
</Layout>
