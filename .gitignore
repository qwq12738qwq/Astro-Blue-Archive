# Dependencies
node_modules/
astro/dist/
astro/.astro/
backend/server
backend/healthcheck

# Runtime data (content/, media/ and data/ ARE persisted via Docker volumes,
# but must not be committed as build artefacts)
data/*.db
data/*.db-shm
data/*.db-wal
data/session_secret
media/*
!media/.gitkeep
!data/.gitkeep

# The site's own articles and pages are the deployer's content, not
# part of the project: they stay on disk (and in the deployment's
# volumes) and never land in git.
content/posts/
content/pages/

# Local env
.env
.env.local

# Astro tooling cache (generated by `astro check`)
.astro/

# Editor / OS
.DS_Store
*.swp

# Local build artefacts
backend/bin/

# Backup archives are produced by scripts/backup.sh
data/backups/
# Derived image cache; keyed by checksum, regenerated on demand
data/media-cache/
# The local Git backup repository (Git Backup Phase 1). It is a *versioned
# copy of* this project's content, derived state — and a Git repository nested
# inside another one is exactly the shape nobody should commit by accident.
#
# This ignores the repository the CMS keeps for a *deployed site*, which is not
# the same repository as this source tree. It does NOT weaken the CMS's own
# backup: that repository's inclusion policy is decided by
# backend/internal/backup/policy.go, and content/ is never ignored there. The
# lines above that ignore content/posts/ apply to *this* project, whose articles
# are the deployer's content rather than project source.
data/git-backup/
.playwright-mcp/
.local-run/

# Agent-tooling state and working notes, not project source
.commandcode/
.opencode/
