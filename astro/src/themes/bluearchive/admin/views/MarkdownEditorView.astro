---
/**
 * 独立的 Markdown 编辑器。
 *
 * ARCHITECTURE.md §33/§34:一屏编辑三样东西 —— 文章正文
 * (`?kind=post&slug=…`)、页面正文(`?kind=page&slug=…`)或样式模板的
 * CSS(`?kind=template&name=…`)。正文两侧都带实时预览,由
 * `/api/v1/markdown/preview` 渲染,跑的是文章页面同一个 `renderMarkdown()`。
 *
 * 行为全部是核心的:三个表单复用既有的 `data-cms-form="post"` /
 * `"page"` / `"markdown-template"` 处理器,预览复用 `data-cms-region` 绑定,所以
 * 主题不携带任何行为。CSRF 令牌由核心页面放进 data 属性,/cms.js 读取;
 * 主题既不能铸造它,也不能省掉它。
 */
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminNotice from '../components/AdminNotice.astro';

import { MARKDOWN_STYLESHEET } from '../../../../theme-system/js-contract';
import { loadCssEffects } from '../../../../lib/css-effects';
import type {
  AdminShellView,
  MarkdownEditorView as EditorView,
  Notice,
  SeoView,
} from '../../../../theme-system/contract';

const cssEffects = await loadCssEffects();

interface Props {
  theme: { id: string };
  shell: AdminShellView;
  seo: SeoView;
  view: EditorView;
  notice?: Notice | null;
  csrfToken: string;
  signedIn: boolean;
}

const { theme, shell, seo, view, notice = null, csrfToken, signedIn } = Astro.props;

const fields = view.fields;
/** A page and a post both save as whole documents, so they share this branch. */
const entry = view.kind === 'post' || view.kind === 'page';
const backHref = entry
  ? `/admin/${view.kind === 'page' ? 'pages' : 'posts'}/${view.target}`
  : '/admin/custom-code';
const backLabel = entry ? (view.kind === 'page' ? '返回页面' : '返回文章') : '返回 CSS 库';
---

<AdminLayout theme={theme} shell={shell} seo={seo} csrfToken={csrfToken} signedIn={signedIn}>
  {
    /*
      The preview renders article content, so it needs the template pack.
      A `<link>` in the body is valid HTML and every browser applies it; the
      admin layout has no head slot to put it in. It sits after the theme
      stylesheet the layout already emitted, matching the public site's order.
    */
  }
  <link rel="stylesheet" href={MARKDOWN_STYLESHEET} />

  <div class="admin-bar">
    <h1>{view.kind === 'template' ? '编辑样式模板' : '编辑正文'}</h1>
    <a class="btn" href={backHref}>{backLabel}</a>
  </div>

  <AdminNotice notice={notice} />

  <p class="muted">
    <code>{view.target}</code>
    {
      view.kind === 'template' ? (
        <span> — 参与 /markdown.css 的样式模板</span>
      ) : (
        <span> — {view.title}</span>
      )
    }
  </p>

  {
    entry ? (
      <form
        id="markdown-editor-form"
        class="markdown-editor-form"
        novalidate
        data-cms-form={view.kind}
        data-cms-mode="update"
        data-cms-slug={view.target}
        data-cms-csrf={csrfToken}
      >
        {/*
            Both PUTs are full replaces, so the frontmatter the page loaded
            travels with the body. `draft` is a checkbox on purpose: the core
            script reads presence, so an unchecked box (absent) means false.
          */}
        {fields && (
          <>
            <input type="hidden" name="title" value={fields.title} />
            <input type="hidden" name="slug" value={fields.slug} />
            <input type="hidden" name="description" value={fields.description} />
            <input type="hidden" name="date" value={fields.date} />
            {/*
                A page's frontmatter has no tags, and its date is the day the
                body is saved. Neither is editable here, so a page omits both
                and the core script fills them in.
              */}
            {view.kind === 'post' && (
              <>
                <input type="hidden" name="tags" value={fields.tags} />
                <input type="hidden" name="cover" value={fields.cover} />
              </>
            )}
            {view.kind === 'page' && fields.navOrder !== undefined && (
              <input type="hidden" name="navOrder" value={fields.navOrder} />
            )}
            <input type="checkbox" name="draft" checked={fields.draft} hidden />
          </>
        )}

        <div class="markdown-editor-screen">
          <div class="markdown-editor-pane">
            <label for="markdown-source">正文 (Markdown)</label>
            {/*
             * An Astro `<textarea>` keeps the whitespace that precedes its
             * `{expression}`, so the element stays on a single line — the
             * file's text must be the value verbatim, or every save would
             * prepend the template's own indentation to the body (§33).
             */}
            <textarea
              id="markdown-source"
              name="body"
              class="code-editor markdown-editor"
              spellcheck="true"
              data-cms-region="markdown-editor"
            >
              {view.content}
            </textarea>
          </div>
        </div>

        <div class="field-inline">
          <button class="btn btn-primary" type="submit">
            保存
          </button>
          <span class="spinner" data-cms-spinner hidden>
            保存中…
          </span>
          <label for="preview-toggle" class="btn markdown-sidebar-toggle">
            预览
          </label>
          <a class="btn" href={backHref}>
            取消
          </a>
        </div>

        <div
          class="field"
          data-cms-form="upload"
          data-cms-insert-markdown="body"
          data-cms-csrf={csrfToken}
          data-cms-upload-started-at={Date.now()}
        >
          <p class="hint">向正文插入图片</p>
          <div class="field-inline">
            <label class="visually-hidden" for="body-image">
              选择图片
            </label>
            <input
              id="body-image"
              name="file"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/gif"
            />
            <button class="btn" type="button" data-cms-upload-submit>
              上传并插入
            </button>
            <span class="spinner" data-cms-spinner hidden>
              上传中…
            </span>
            <p class="field-error" data-cms-error-for="file" hidden />
          </div>
          <p class="hint">
            先上传到媒体库,然后在光标处写入 <code>![name](/media/…)</code>。文件本身绝不会 内联进
            Markdown。
          </p>
        </div>

        <details class="css-effect-library" data-cms-css-effect-library>
          <summary>CSS 效果库</summary>
          <div class="css-effect-library-body">
            <input
              type="search"
              class="css-effect-search"
              placeholder="搜索效果名称、类名…"
              data-cms-css-effect-search
            />
            <ul class="css-effect-list">
              {cssEffects.map((effect: (typeof cssEffects)[number]) => (
                <li
                  class="css-effect-row"
                  data-cms-css-effect-row
                  data-css-effect-id={effect.id}
                  data-css-effect-category={effect.category}
                  data-css-effect-search={`${effect.name} ${effect.id} ${effect.className} ${effect.category} ${effect.description}`}
                >
                  <div class="css-effect-row-head">
                    <strong>{effect.name}</strong>
                    <span class="css-effect-category">{effect.category}</span>
                  </div>
                  <p class="muted css-effect-desc">{effect.description}</p>
                  <code class="css-effect-class">{effect.className}</code>
                  <div class="css-effect-actions">
                    <button
                      type="button"
                      class="btn"
                      data-cms-action="insert-css-effect"
                      data-cms-snippet={effect.snippet}
                    >
                      插入
                    </button>
                  </div>
                  <pre class="css-effect-example">
                    <code>{effect.snippet}</code>
                  </pre>
                </li>
              ))}
            </ul>
          </div>
        </details>
      </form>
    ) : (
      <form
        id="markdown-editor-form"
        class="markdown-editor-form"
        novalidate
        data-cms-form="markdown-template"
        data-cms-mode={view.target === '' ? 'create' : 'update'}
        data-cms-id={view.target === '' ? undefined : view.target}
        data-cms-csrf={csrfToken}
        data-cms-unsaved-guard
      >
        {view.target === '' ? (
          <div class="field">
            <label for="new-template-name">文件名</label>
            <input
              id="new-template-name"
              name="filename"
              type="text"
              placeholder="NNN-name.css"
              spellcheck="false"
              autocapitalize="off"
              required
            />
          </div>
        ) : (
          <input type="hidden" name="filename" value={view.target} />
        )}

        <div class="markdown-editor-pane">
          <label for="markdown-source">CSS</label>
          {/* Single line for the same reason as the body field above. */}
          <textarea
            id="markdown-source"
            name="content"
            class="code-editor markdown-editor"
            spellcheck="false"
          >
            {view.content}
          </textarea>
          <p class="hint">
            所有选择器都应限定在 <code>.markdown-body</code> 内。保存后刷新文章页即可看到效果。
          </p>
        </div>

        <div class="field-inline">
          <button class="btn btn-primary" type="submit">
            保存
          </button>
          <span class="spinner" data-cms-spinner hidden>
            保存中…
          </span>
          <a class="btn" href={backHref}>
            取消
          </a>
        </div>
      </form>
    )
  }

  <input type="checkbox" id="preview-toggle" class="markdown-sidebar-checkbox" />
  <div class="markdown-sidebar-panel" data-cms-preview-panel>
    <div class="markdown-sidebar-body">
      <div class="markdown-preview-pane">
        <div class="markdown-preview" data-cms-region="markdown-preview">
          <p class="hint">预览会显示在这里。</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { enhanceTextArea } from '../../../../lib/codemirror-enhance';
    const ta = document.querySelector('#markdown-source');
    if (ta instanceof HTMLTextAreaElement) {
      enhanceTextArea(ta, 'markdown');
    }
  </script>
</AdminLayout>
